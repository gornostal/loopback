# Port the HTTP server listens on.
PORT=8787

# Shared secret. Agents and the Android app send it as `Authorization: Bearer <key>`.
# Generate one with: openssl rand -hex 32
LOOPBACK_API_KEY=change-me

# Where the SQLite database lives (created on first run).
DATA_DIR=./data

# Firebase service account JSON (Project settings → Service accounts → Generate new private key).
# Used to send FCM pushes. If neither variable is set, requests are stored but no push is sent.
# Either a path to the file...
FIREBASE_SERVICE_ACCOUNT=./service-account.json
# ...or the file's contents base64-encoded (for hosts like Railway where you can't ship a file).
# Takes precedence over the path. Generate with: base64 -w0 service-account.json
# FIREBASE_SERVICE_ACCOUNT_B64=
