<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives all in-app colors (ui/theme/Theme.kt). This only styles the
         pre-Compose window so the app doesn't flash a default-themed frame. -->
    <style name="Theme.Loopback" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
