<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives all in-app colors (ui/theme/Theme.kt). The app is dark-only, so this
         just styles the pre-Compose window so it doesn't flash a light frame on launch. -->
    <style name="Theme.Loopback" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
