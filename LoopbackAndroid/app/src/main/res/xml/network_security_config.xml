<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP so the app can talk to a Loopback server on your LAN during
     development (e.g. http://192.168.1.10:8787). Use HTTPS for anything public. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
